{
  "type": "object",
  "required": [
    "run_id",
    "angle_id",
    "topic",
    "format",
    "core_message",
    "key_points",
    "audience",
    "required_terms",
    "out_of_scope",
    "allowed_entities",
    "facts",
    "compiled_from"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "angle_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "core_message": {
      "type": "string"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "fact_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^K[1-3]$"
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^F\\d{3}$"
            }
          }
        }
      }
    },
    "audience": {
      "type": "string"
    },
    "required_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F\\d{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "raw"
              ],
              "properties": {
                "raw": {
                  "type": "string"
                },
                "as_of": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "tier",
              "publisher",
              "title",
              "accessed"
            ],
            "properties": {
              "tier": {
                "enum": [
                  "tier1",
                  "tier2",
                  "tier3",
                  "internal"
                ]
              },
              "publisher": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "published": {
                "type": "string"
              },
              "accessed": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "provided_by": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            }
          },
          "evidence_excerpt": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "approved",
              "rejected",
              "lead_only"
            ]
          },
          "added_by": {
            "enum": [
              "ai",
              "human"
            ]
          },
          "reviewed_by": {
            "type": "string"
          },
          "review_note": {
            "type": "string"
          }
        }
      }
    },
    "compiled_from": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}