{
  "type": "object",
  "required": [
    "core_message",
    "locked_brief_sha256",
    "format",
    "beats"
  ],
  "properties": {
    "core_message": {
      "type": "string"
    },
    "locked_brief_sha256": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text",
          "fact_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B\\d{2}$"
          },
          "kind": {
            "enum": [
              "hook",
              "point",
              "proof",
              "recap",
              "cta",
              "disclaimer",
            "disclosure"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 3
          },
          "key_point": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F\\d{3}$"
            }
          },
          "disclaimer_id": {
            "type": "string"
          },
          "visual_note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}