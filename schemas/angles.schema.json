{
  "type": "object",
  "required": [
    "angles"
  ],
  "properties": {
    "angles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "core_message",
          "key_points",
          "audience",
          "format",
          "why_now",
          "required_terms",
          "out_of_scope",
          "allowed_entities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A\\d$"
          },
          "title": {
            "type": "string"
          },
          "core_message": {
            "type": "string",
            "minLength": 15
          },
          "key_points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "fact_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^K[1-3]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 10
                },
                "fact_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^F\\d{3}$"
                  }
                }
              }
            }
          },
          "audience": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "why_now": {
            "type": "string"
          },
          "required_terms": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "selected": {
      "type": "object",
      "required": [
        "angle_id",
        "selected_by",
        "selected_on"
      ],
      "properties": {
        "angle_id": {
          "type": "string"
        },
        "selected_by": {
          "type": "string"
        },
        "selected_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "edits": {
          "type": "string"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}